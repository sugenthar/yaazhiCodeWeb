{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "yaazhicode",
  "version": "0.1.0",
  "description": "Machine-readable specification for the YaazhiCode programming language",
  "homepage": "https://yaazhi-code-web.vercel.app/",
  "repository": "https://github.com/sugenthar/yaazhiCode",
  "npmPackage": "https://www.npmjs.com/package/yaazhicode",
  "idePackage": "https://www.npmjs.com/package/yaazhicode-ide",
  "fileExtension": ".yaazhi",
  "executionApi": "https://yaazhi-code-web.vercel.app/api/execute",
  "rules": {
    "identifierAlphabet": "Tamil Unicode (U+0B80-U+0BFF), underscore (_), and dollar ($). ASCII English letters [a-zA-Z] are strictly forbidden.",
    "numeralPrefix": "$",
    "digitGlyphs": {
      "0": "௦",
      "1": "௧",
      "2": "௨",
      "3": "௩",
      "4": "௪",
      "5": "௫",
      "6": "௬",
      "7": "௭",
      "8": "௮",
      "9": "௯"
    },
    "numeralSyntax": "Prefix with $ followed by Tamil digits (e.g. $௧, $௨௫, $௧௦௦, $௩.௧௪). ASCII digits are forbidden as code literals."
  },
  "keywords": [
    { "tamil": "மாறி", "role": "let", "category": "declaration" },
    { "tamil": "நிலையான", "role": "const", "category": "declaration" },
    { "tamil": "மாற்றி", "role": "mutable_counter", "category": "declaration" },
    { "tamil": "என்றால்", "role": "if", "category": "conditional" },
    { "tamil": "இல்லை", "role": "else", "category": "conditional" },
    { "tamil": "இல்லையெனில்", "role": "else_if", "category": "conditional" },
    { "tamil": "தேர்ந்தெடு", "role": "switch", "category": "conditional" },
    { "tamil": "நிலை", "role": "case", "category": "conditional" },
    { "tamil": "இயல்புநிலை", "role": "default", "category": "conditional" },
    { "tamil": "ஒவ்வொரு", "role": "for", "category": "loop" },
    { "tamil": "இருக்கும்வரை", "role": "while", "category": "loop" },
    { "tamil": "உள்ளே", "role": "in_of", "category": "loop" },
    { "tamil": "நிறுத்து", "role": "break", "category": "control" },
    { "tamil": "தொடரு", "role": "continue", "category": "control" },
    { "tamil": "செயல்", "role": "function", "category": "function" },
    { "tamil": "கொடு", "role": "return", "category": "function" },
    { "tamil": "ஒத்திசைவற்ற", "role": "async", "category": "async" },
    { "tamil": "காத்திரு", "role": "await", "category": "async" },
    { "tamil": "வகுப்பு", "role": "class", "category": "oop" },
    { "tamil": "உருவாக்கு", "role": "constructor", "category": "oop" },
    { "tamil": "இது", "role": "this", "category": "oop" },
    { "tamil": "புதிய", "role": "new", "category": "oop" },
    { "tamil": "மரபுரிமை", "role": "extends", "category": "oop" },
    { "tamil": "முதன்மை", "role": "super", "category": "oop" },
    { "tamil": "நிலையியல்", "role": "static", "category": "oop" },
    { "tamil": "முயற்சி", "role": "try", "category": "exception" },
    { "tamil": "பிடி", "role": "catch", "category": "exception" },
    { "tamil": "இறுதியாக", "role": "finally", "category": "exception" },
    { "tamil": "வீசு", "role": "throw", "category": "exception" },
    { "tamil": "இறக்குமதி", "role": "import", "category": "module" },
    { "tamil": "ஏற்றுமதி", "role": "export", "category": "module" },
    { "tamil": "இருந்து", "role": "from", "category": "module" },
    { "tamil": "உண்மை", "role": "true", "category": "literal" },
    { "tamil": "பொய்", "role": "false", "category": "literal" },
    { "tamil": "வெற்று", "role": "null", "category": "literal" },
    { "tamil": "வகையறி", "role": "typeof", "category": "operator" },
    { "tamil": "உறுதிப்படுத்து", "role": "assert", "category": "test" }
  ],
  "builtinFunctions": [
    { "name": "அச்சிடு", "description": "Prints arguments to stdout with newline" },
    { "name": "உரையாக்கு", "description": "Converts value to Tamil string representation" },
    { "name": "வடிவமை", "description": "String formatting template" },
    { "name": "சேர்", "description": "Append an element to an array" },
    { "name": "வரைபடம்", "description": "Map an array with a callback function" },
    { "name": "வடிகட்டு", "description": "Filter an array with a predicate callback" },
    { "name": "இணை", "description": "Join array items into a string with delimiter" },
    { "name": "நீளம்", "description": "Get length of array or string" }
  ],
  "builtinModules": [
    "வலை",
    "கோப்பு",
    "கணிதம்",
    "உரை",
    "பட்டியல்",
    "நேரம்",
    "முனையம்",
    "கணினி",
    "குறியாக்கம்",
    "வடிவம்",
    "உறுதிப்படுத்து",
    "பிழை",
    "சுழற்சி",
    "நினைவகம்",
    "வழி",
    "தரவு",
    "வலை_வாடிக்கையாளர்"
  ]
}
